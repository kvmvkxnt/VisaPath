# /etc/sentinel/agent.env, mode 0640, owner root:sentinel.

# host:port of sentinel-ingest. The host must be in the ingest certificate
# (INGEST_SANS on the server).
AGENT_INGEST_ADDR=

# From `docker compose run --rm certs agent <host>` on the server.
AGENT_TLS_CERT=/etc/sentinel/agent.pem
AGENT_TLS_KEY=/etc/sentinel/agent.key
AGENT_TLS_CA=/etc/sentinel/ca.pem

# Logs to follow. Remove a line to skip that log.
AGENT_NGINX_LOG=/var/log/nginx/access.log
AGENT_SSH_LOG=/var/log/auth.log
